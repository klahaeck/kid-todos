# MongoDB must be Atlas or an initialized replica set, rather than standalone.
# For local MongoDB, start with --replSet rs0 and initialize that replica set.
MONGODB_URI=mongodb://127.0.0.1:27017/kid-todos?replicaSet=rs0
MONGODB_DB_NAME=kid-todos

# Clerk application keys (never commit real values).
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=
# Also configure the issuer in Convex and create a Clerk JWT template named convex.
CLERK_JWT_ISSUER_DOMAIN=

# Obtain the deployment URL from the Convex CLI/dashboard.
NEXT_PUBLIC_CONVEX_URL=
# Set the same secret in the Next.js and Convex deployment environments.
CONVEX_SERVER_SECRET=

# Household invitation email.
NEXT_PUBLIC_APP_URL=http://localhost:3000
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
EMAIL_FROM=

# Optional household limits.
HOUSEHOLD_MAX_MEMBERS=10
HOUSEHOLD_MAX_PENDING_INVITES=20
